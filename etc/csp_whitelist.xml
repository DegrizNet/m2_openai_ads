<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="openai_sdk" type="host">bzrcdn.openai.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="openai_sdk" type="host">bzrcdn.openai.com</value>
                <value id="openai_api" type="host">bzr.openai.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="openai_pixel" type="host">bzr.openai.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
